/* ============ 存钱罐 piggy-jar（奶油色小猪，适配深绿卡片） ============ */
.jar-wrap {
  position: relative;
  display: inline-flex;
  align-items: flex-end;
  justify-content: center;
  width: 150rpx;
  height: 138rpx;
  flex-shrink: 0;
}

.jar {
  position: relative;
  width: 150rpx;
  height: 138rpx;
}

/* 身体 */
.jar-body {
  position: absolute;
  left: 7rpx;
  bottom: 20rpx;
  width: 136rpx;
  height: 100rpx;
  overflow: hidden;
  border-radius: 50% 50% 47% 47% / 58% 58% 44% 44%;
  background: linear-gradient(160deg, #fffaf0 0%, #f7edd8 55%, #ecdcbd 100%);
  box-shadow:
    inset -7rpx -9rpx 16rpx rgba(180, 158, 116, 0.35),
    inset 7rpx 9rpx 14rpx rgba(255, 255, 255, 0.75),
    0 8rpx 18rpx rgba(20, 45, 32, 0.3);
}

/* 罐内金币液面 */
.jar-coins {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 0;
  background: linear-gradient(180deg, #ffe9a8 0%, #f7c948 52%, #e0a52f 100%);
  transition: height 0.55s cubic-bezier(0.34, 1.3, 0.5, 1);
}
.jar-coins::before {
  content: '';
  position: absolute;
  top: -9rpx;
  left: 0;
  right: 0;
  height: 18rpx;
  background: radial-gradient(circle at 11rpx 9rpx, #ffe9a8 8rpx, transparent 9rpx) repeat-x;
  background-size: 24rpx 18rpx;
}

/* 鼻子 */
.jar-snout {
  position: absolute;
  left: 50%;
  top: 54rpx;
  transform: translateX(-50%);
  width: 46rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #f8c3b6, #eda48f);
  box-shadow: inset 0 -3rpx 5rpx rgba(160, 92, 70, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  z-index: 3;
}
.snout-hole {
  width: 7rpx;
  height: 11rpx;
  border-radius: 4rpx;
  background: #a35f4b;
}

/* 眼睛 */
.jar-eye {
  position: absolute;
  top: 34rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4b3d29;
  z-index: 4;
}
.eye-l { left: 30rpx; }
.eye-r { right: 30rpx; }

/* 耳朵 */
.jar-ear {
  position: absolute;
  top: 8rpx;
  width: 36rpx;
  height: 32rpx;
  background: linear-gradient(160deg, #fbf2e2, #e9d8b8);
  z-index: 0;
}
.ear-l { left: 16rpx; border-radius: 72% 14% 34% 22%; transform: rotate(-24deg); }
.ear-r { right: 16rpx; border-radius: 14% 72% 22% 34%; transform: rotate(24deg); }

/* 尾巴 */
.jar-tail {
  position: absolute;
  right: 0;
  bottom: 54rpx;
  width: 22rpx;
  height: 22rpx;
  border: 5rpx solid #e6d6b6;
  border-right-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
  transform: rotate(-40deg);
  z-index: 0;
}

/* 投币口 */
.jar-slot {
  position: absolute;
  top: 22rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #8a6a3d;
  z-index: 5;
  box-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.6);
}

/* 腿 */
.jar-leg {
  position: absolute;
  bottom: 6rpx;
  width: 26rpx;
  height: 28rpx;
  border-radius: 0 0 12rpx 12rpx;
  background: linear-gradient(180deg, #efe0c2, #e0cfa9);
  z-index: 2;
}
.leg-l { left: 28rpx; }
.leg-r { right: 28rpx; }

/* 晃动动画 */
@keyframes jarShake {
  0%   { transform: translateY(0) scale(1, 1); }
  35%  { transform: translateY(-7rpx) scale(1.06, 0.94); }
  70%  { transform: translateY(3rpx) scale(0.97, 1.05); }
  100% { transform: translateY(0) scale(1, 1); }
}
.jar-bounce .jar { animation: jarShake 0.3s ease; }

/* 小星星 */
.jar-spark { position: absolute; left: 50%; top: 52rpx; width: 0; height: 0; }
.sp {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffd76a;
  opacity: 0;
}
@keyframes sp1 {
  0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translate(-44rpx, -50rpx) scale(1); opacity: 0; }
}
@keyframes sp2 {
  0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translate(8rpx, -62rpx) scale(1); opacity: 0; }
}
@keyframes sp3 {
  0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: translate(46rpx, -46rpx) scale(1); opacity: 0; }
}
.sp1 { animation: sp1 0.62s ease-out; }
.sp2 { animation: sp2 0.62s ease-out; }
.sp3 { animation: sp3 0.62s ease-out; }

/* ============ 飞行金币 ============ */
.coin-layer {
  position: fixed;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  z-index: 9999;
  pointer-events: none;
}

.fly-coin {
  position: fixed;
  width: 44rpx;
  height: 44rpx;
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.4, 0.05, 0.55, 0.95);
  will-change: transform;
}

.coin-move {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  height: 100%;
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.2, 0.7, 0.35, 1);
  will-change: transform;
}

.coin-face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #e0a52c;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 30%, #fff6cf 0%, #ffd257 45%, #e8a92f 100%);
  box-shadow:
    0 5rpx 10rpx rgba(214, 150, 30, 0.5),
    inset 0 0 7rpx rgba(255, 255, 255, 0.65);
}

.coin-symbol {
  font-size: 26rpx;
  font-weight: 700;
  color: #a06a12;
}

.coin-label {
  margin-top: 7rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffd257;
  text-shadow: 0 1rpx 3rpx rgba(120, 80, 10, 0.55);
  white-space: nowrap;
}
