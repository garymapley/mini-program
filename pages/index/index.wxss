.page { min-height: 100vh; padding: 24rpx 34rpx 0; box-sizing: border-box; }
.topline { height: 76rpx; display:flex; align-items:center; justify-content:space-between; margin-bottom:24rpx; }
.brand { display:flex; align-items:center; gap:12rpx; font-size:31rpx; font-weight:750; letter-spacing:1rpx; }.brand-icon { color:#64a582; font-size:36rpx; }.topline-right { display:flex; align-items:center; gap:14rpx; }.guide-entry { color:#778478; background:#e9eee5; border-radius:20rpx; padding:8rpx 14rpx; font-size:20rpx; }.streak { background:#fff0df; color:#b96c37; border-radius:30rpx; padding:12rpx 20rpx; font-size:23rpx; font-weight:600; }
.hero { position:relative; overflow:hidden; min-height:360rpx; border-radius:32rpx; background:#28664f; padding:32rpx 34rpx 28rpx; box-sizing:border-box; color:#fff; box-shadow:0 14rpx 34rpx rgba(33,91,68,.17); }
.hero-kicker { position:relative; z-index:1; font-size:23rpx; color:#c8e4d1; letter-spacing:1rpx; }.hero-title { position:relative; z-index:1; margin-top:28rpx; font-size:29rpx; font-weight:500; color:#ebf4e9; }.total-row { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; margin-top:2rpx; }.total-line { display:flex; align-items:baseline; }.currency { font-size:39rpx; font-weight:600; margin-right:9rpx; }.total { font-family:Arial,sans-serif; font-size:92rpx; font-weight:700; letter-spacing:-2rpx; }.hero-bottom { position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between; margin-top:14rpx; color:#cee2d3; font-size:22rpx; }.count-pill { padding:8rpx 16rpx; border-radius:24rpx; background:rgba(255,255,255,.14); color:#fff; }
.sun { position:absolute; border-radius:50%; background:rgba(197,218,160,.11); }.sun-one { width:270rpx; height:270rpx; right:-65rpx; top:-94rpx; }.sun-two { width:160rpx; height:160rpx; right:100rpx; bottom:-115rpx; }
.quick-stats { display:flex; align-items:center; background:#fff; border-radius:24rpx; margin-top:20rpx; padding:25rpx 28rpx; box-shadow:0 7rpx 22rpx rgba(37,62,46,.035); }.stat { flex:1; display:flex; flex-direction:column; gap:11rpx; }.stat-label { font-size:22rpx; color:#8a948b; }.stat-value { font-size:35rpx; line-height:1; font-weight:720; color:#254d3e; }.unit { font-size:22rpx; font-weight:500; }.stat-divider { width:1rpx; height:66rpx; background:#edf0ea; margin:0 28rpx; }
.section-head { display:flex; align-items:flex-end; justify-content:space-between; margin:36rpx 2rpx 18rpx; }.section-head view { display:flex; flex-direction:column; gap:9rpx; }.section-title { font-size:30rpx; font-weight:720; }.section-sub { font-size:20rpx; color:#969d95; }.date-chip { color:#778478; background:#e9eee5; border-radius:20rpx; padding:8rpx 14rpx; font-size:20rpx; }
.record-list { display:flex; flex-direction:column; gap:13rpx; }.record-swipe { position:relative; overflow:hidden; border-radius:21rpx; background:transparent; }.record-actions { position:absolute; top:0; right:0; height:100%; display:flex; }.action-btn { width:120rpx; display:flex; align-items:center; justify-content:center; font-size:22rpx; color:#fff; letter-spacing:1rpx; }.action-pin { background:#6f9e86; }.action-del { background:#d66c4b; }.record-card { position:relative; z-index:1; display:flex; align-items:center; padding:22rpx 19rpx; border-radius:21rpx; background:#fff; will-change:transform; }.record-icon { width:70rpx; height:70rpx; display:flex; align-items:center; justify-content:center; background:#f1f5ed; border-radius:20rpx; font-size:34rpx; flex-shrink:0; }.record-main { flex:1; min-width:0; padding:2rpx 12rpx 0 16rpx; }.record-title { font-size:25rpx; font-weight:650; color:#303b34; }.record-reason { margin-top:7rpx; font-size:21rpx; color:#7d897e; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.record-time { margin-top:12rpx; color:#a2aaa1; font-size:19rpx; }.record-right { display:flex; flex-direction:column; align-items:flex-end; gap:15rpx; padding-top:4rpx; }.record-amount { color:#378360; font-size:24rpx; font-weight:700; white-space:nowrap; }.record-tap { display:none; }
.empty { margin-top:17rpx; min-height:260rpx; background:#fff; border-radius:24rpx; display:flex; flex-direction:column; justify-content:center; align-items:center; }.empty-art { font-size:50rpx; }.empty-title { margin-top:13rpx; font-size:25rpx; font-weight:650; color:#526256; }.empty-copy { margin-top:8rpx; font-size:21rpx; color:#a0a79f; }
.bottom-space { height:220rpx; }.sticky { position:fixed; bottom:0; left:0; right:0; padding:18rpx 34rpx calc(env(safe-area-inset-bottom) + 20rpx); background:rgba(247,248,242,.96); z-index:3; }.add-button,.save-button { width:100%; height:92rpx; border-radius:25rpx; display:flex; align-items:center; justify-content:center; background:#28664f; color:#fff; font-size:29rpx; font-weight:650; box-shadow:0 8rpx 18rpx rgba(40,102,79,.17); }.plus { font-size:38rpx; margin-right:12rpx; font-weight:400; }.privacy-note { display:block; margin-top:12rpx; text-align:center; color:#9aa49b; font-size:19rpx; }
.mask { position:fixed; inset:0; z-index:10; display:flex; align-items:flex-end; background:rgba(22,35,27,.42); }.sheet { width:100%; box-sizing:border-box; padding:13rpx 34rpx calc(env(safe-area-inset-bottom) + 27rpx); border-radius:32rpx 32rpx 0 0; background:#fafbf7; max-height:92vh; overflow-y:auto; }.sheet-handle { width:66rpx; height:7rpx; border-radius:8rpx; background:#dce2d9; margin:0 auto 20rpx; }.sheet-head { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:22rpx; }.sheet-head view { display:flex; flex-direction:column; gap:7rpx; }.sheet-title { font-size:32rpx; font-weight:730; }.sheet-sub { color:#8e998f; font-size:21rpx; }.close { font-size:44rpx; color:#9ba49b; line-height:1; padding:0 5rpx; }.field-label { font-size:23rpx; color:#526057; font-weight:630; margin:20rpx 0 10rpx; }.input,.amount-input,.textarea { box-sizing:border-box; border-radius:16rpx; background:#fff; border:1rpx solid #edf0e9; }.input { width:100%; height:76rpx; padding:0 20rpx; font-size:24rpx; }.amount-input { height:82rpx; display:flex; align-items:center; padding:0 19rpx; color:#458365; font-size:28rpx; font-weight:700; }.amount-input input { flex:1; margin-left:13rpx; height:100%; color:#25372d; font-size:36rpx; font-weight:650; }.categories { display:flex; gap:13rpx; }.category { padding:13rpx 22rpx; border-radius:15rpx; color:#768277; background:#eef1ea; font-size:21rpx; }.category.selected { color:#28664f; background:#dcece0; font-weight:650; }.textarea { width:100%; height:104rpx; padding:15rpx 18rpx; font-size:22rpx; }.save-button { height:82rpx; margin-top:22rpx; font-size:27rpx; }
.balance-card { position:relative; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; background:#fff; border:1rpx solid #edf0e9; border-radius:22rpx; margin-top:17rpx; padding:20rpx 23rpx 34rpx; }.balance-copy { display:flex; flex-direction:column; gap:8rpx; }.balance-label { color:#758176; font-size:21rpx; }.balance-value { color:#284f3f; font-size:32rpx; font-weight:700; }.balance-placeholder { color:#9da69d; font-size:25rpx; }.balance-edit { border:1rpx solid #dfe9dd; background:#f1f6ed; border-radius:14rpx; padding:8rpx 21rpx; color:#397253; font-size:21rpx; }.balance-note { position:absolute; left:23rpx; bottom:11rpx; color:#a5ada4; font-size:17rpx; }.balance-sheet { padding-bottom:calc(env(safe-area-inset-bottom) + 45rpx); }
.amount-presets { display:flex; gap:12rpx; margin-top:12rpx; }.amount-preset { flex:1; padding:13rpx 0; border-radius:14rpx; background:#eef1ea; color:#647468; text-align:center; font-size:21rpx; }.amount-preset.preset-selected { color:#28664f; background:#dcece0; font-weight:650; }
.reference-card { margin-top:16rpx; padding:22rpx 23rpx; border-radius:22rpx; background:#fff; border:1rpx solid #e9eee6; box-shadow:0 7rpx 22rpx rgba(37,62,46,.035); }.reference-heading { display:flex; justify-content:space-between; align-items:center; }.reference-heading > view { display:flex; flex-direction:column; gap:6rpx; }.reference-title { color:#304a3b; font-size:25rpx; font-weight:700; }.reference-caption { color:#929c93; font-size:19rpx; }.period-switch { display:flex; margin-top:18rpx; padding:5rpx; gap:5rpx; border-radius:15rpx; background:#f1f4ee; }.period-option { flex:1; padding:12rpx; border-radius:12rpx; color:#7d897f; text-align:center; font-size:21rpx; }.period-option.period-active { color:#28664f; background:#fff; font-weight:700; box-shadow:0 3rpx 8rpx rgba(37,62,46,.08); }.reference-content { display:flex; flex-direction:column; align-items:center; padding-top:18rpx; }.reference-total { color:#28664f; font-size:48rpx; font-weight:750; }.reference-equation { margin-top:7rpx; color:#778379; font-size:21rpx; }.reference-equation text { padding:0 8rpx; color:#9baa9c; }.reference-dates { margin-top:13rpx; color:#758176; font-size:20rpx; }.reference-status { margin-top:7rpx; color:#438263; font-size:20rpx; }.reference-note { margin-top:13rpx; color:#a0a9a0; font-size:17rpx; text-align:center; line-height:1.5; }.reference-empty { margin-top:18rpx; padding:18rpx 12rpx; border-radius:14rpx; background:#f5f7f2; color:#8e998f; text-align:center; font-size:21rpx; }
.record-tap { margin-top:8rpx; font-size:18rpx; color:#b3bcb2; }
.card-mask { position:fixed; inset:0; z-index:20; display:flex; align-items:center; justify-content:center; background:rgba(20,35,27,.62); }
.gacha { position:relative; width:520rpx; height:832rpx; border-radius:52rpx; overflow:hidden; display:flex; flex-direction:column; padding:44rpx 44rpx 52rpx; box-sizing:border-box; color:#fff; box-shadow:0 36rpx 80rpx rgba(20,40,30,.4); animation:gachaIn .46s cubic-bezier(.2,.8,.3,1.1); }
.gacha::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at 50% -10%, rgba(255,255,255,.45), transparent 60%); z-index:1; }
.gacha::after { content:''; position:absolute; inset:0; border-radius:52rpx; border:3rpx solid rgba(255,255,255,.5); box-shadow:inset 0 0 60rpx rgba(255,255,255,.18); z-index:5; pointer-events:none; }
.gacha-ring { position:absolute; border-radius:50%; background:rgba(255,255,255,.09); z-index:0; }
.gacha-ring-a { width:400rpx; height:400rpx; right:-140rpx; top:-120rpx; }
.gacha-ring-b { width:240rpx; height:240rpx; left:-100rpx; bottom:80rpx; }
.gacha-wm { position:absolute; right:-36rpx; bottom:-52rpx; font-size:380rpx; line-height:1; opacity:.18; z-index:0; }
.gacha-cat { position:relative; z-index:3; align-self:flex-start; display:flex; align-items:center; gap:16rpx; padding:14rpx 28rpx; border-radius:40rpx; background:rgba(255,255,255,.22); font-size:30rpx; font-weight:700; letter-spacing:2rpx; }
.gacha-dot { width:16rpx; height:16rpx; border-radius:50%; background:#fff; }
.gacha-body { position:relative; z-index:3; flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center; padding:20rpx 6rpx; }
.gacha-mark { font-size:68rpx; font-weight:800; opacity:.55; line-height:.6; align-self:flex-start; }
.gacha-quote { margin-top:14rpx; font-size:42rpx; font-weight:700; line-height:1.55; text-align:center; text-shadow:0 4rpx 16rpx rgba(0,0,0,.22); word-break:break-word; }
.gacha-foot { position:relative; z-index:3; font-size:24rpx; opacity:.85; letter-spacing:1rpx; text-align:center; }
.gacha-drink { background:linear-gradient(160deg,#8ad7c6 0%,#3fa18d 52%,#1c6d5e 100%); }
.gacha-food { background:linear-gradient(160deg,#ffcf85 0%,#f59f4e 52%,#cf6c28 100%); }
.gacha-shopping { background:linear-gradient(160deg,#f9b0c9 0%,#e96a9e 52%,#ab3b73 100%); }
.gacha-travel { background:linear-gradient(160deg,#94c0ff 0%,#5a8fe6 52%,#2b56b2 100%); }
.gacha-other { background:linear-gradient(160deg,#aede9f 0%,#6cb567 52%,#3b7a3d 100%); }
@keyframes gachaIn { 0% { transform:scale(.6) rotate(-6deg); opacity:0; } 60% { transform:scale(1.04) rotate(2deg); opacity:1; } 100% { transform:scale(1) rotate(0); opacity:1; } }
.guide-mask { position:fixed; inset:0; z-index:30; display:flex; align-items:center; justify-content:center; background:rgba(22,35,27,.5); padding:40rpx; box-sizing:border-box; }
.guide-card { width:100%; max-width:640rpx; background:#fafbf7; border-radius:32rpx; padding:44rpx 38rpx 36rpx; box-sizing:border-box; box-shadow:0 30rpx 70rpx rgba(20,40,30,.35); animation:gachaIn .4s cubic-bezier(.2,.8,.3,1.1); }
.guide-badge { width:96rpx; height:96rpx; margin:0 auto 20rpx; display:flex; align-items:center; justify-content:center; background:#e5f0e5; border-radius:30rpx; font-size:48rpx; }
.guide-title { text-align:center; font-size:36rpx; font-weight:750; color:#254d3e; }
.guide-sub { margin-top:12rpx; text-align:center; font-size:23rpx; color:#7d897e; line-height:1.6; }
.guide-step { display:flex; gap:18rpx; margin-top:28rpx; }
.guide-num { width:44rpx; height:44rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#28664f; color:#fff; font-size:23rpx; font-weight:700; }
.guide-text { display:flex; flex-direction:column; gap:6rpx; }
.guide-step-title { font-size:25rpx; font-weight:650; color:#303b34; }
.guide-step-desc { font-size:21rpx; color:#8a948b; line-height:1.5; }
.guide-btn { margin-top:36rpx; width:100%; height:88rpx; border-radius:24rpx; background:#28664f; color:#fff; font-size:29rpx; font-weight:650; display:flex; align-items:center; justify-content:center; box-shadow:0 8rpx 18rpx rgba(40,102,79,.17); }
.guide-btn::after { border:none; }
